# Static files in this theme: long browser caching and compression.
# Works on Hostinger's LiteSpeed and on Apache. CSS is inlined in <head>, so this mainly covers fonts, images and the manifest.

<IfModule mod_mime.c>
	AddType font/woff2 .woff2
	AddType application/manifest+json .webmanifest
	AddType image/svg+xml .svg
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType font/woff2 "access plus 1 year"
	ExpiresByType image/png "access plus 1 month"
	ExpiresByType image/svg+xml "access plus 1 month"
	ExpiresByType image/x-icon "access plus 1 month"
	ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
	ExpiresByType application/manifest+json "access plus 1 week"
	ExpiresByType text/css "access plus 1 year"
	ExpiresByType application/javascript "access plus 1 year"
	ExpiresByType application/x-javascript "access plus 1 year"
	ExpiresByType text/javascript "access plus 1 year"
</IfModule>

# Theme scripts load with ?ver=<file time>, so a deploy changes the URL and a year of caching is
# safe (audit F13: Hostinger sent JS as application/x-javascript with only 7 days). The service
# worker is served by WordPress at /sw.js, not from here, so it is not affected.
<IfModule mod_headers.c>
	<FilesMatch "\.woff2$">
		Header set Cache-Control "public, max-age=31536000, immutable"
		Header set Access-Control-Allow-Origin "*"
	</FilesMatch>
	<FilesMatch "\.(js|css)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	Header set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/css application/javascript image/svg+xml application/manifest+json
</IfModule>

# Theme source files are not meant to be opened directly, and no PDF is part of the theme (audit F91:
# print-test output was once committed here).
<FilesMatch "\.(md|mjs|pdf)$">
	Require all denied
</FilesMatch>
